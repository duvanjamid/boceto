{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist/lib",
    "declaration": true,
    "declarationDir": "dist/lib",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": false,
    "inlineSources": false,
    "stripInternal": true
  },
  "include": [
    "src/parser.ts",
    "src/types.ts",
    "src/themes.js"
  ],
  "exclude": [
    "src/app",
    "src/boceto-lang.ts",
    "node_modules"
  ]
}
