{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist/lib",
    "declaration": true,
    "declarationDir": "dist/lib",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "sourceMap": false,
    "inlineSources": false,
    "stripInternal": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/parser.ts",
    "src/types.ts",
    "src/themes.js"
  ],
  "exclude": [
    "src/app",
    "src/boceto-lang.ts",
    "node_modules"
  ],
  "angularCompilerOptions": {}
}
